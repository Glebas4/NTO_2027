<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="lep_pole">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <pose>0 0 0 3.1415 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://lep_model/lep_color.glb</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <!-- Тег <material> удалён, чтобы работали цвета из lep_norm.glb -->
      </visual>

      <!-- Упрощённая физическая коллизия (столб) -->
      <collision name="collision">
        <pose>0 0 0.75 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>1.5</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>



